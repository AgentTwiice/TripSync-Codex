{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tripsync/config": ["packages/config/src/index.ts"],
      "@tripsync/domain": ["packages/domain/src/index.ts"],
      "@tripsync/db": ["packages/db/src/index.ts"],
      "@tripsync/providers": ["packages/providers/src/index.ts"],
      "@tripsync/ui": ["packages/ui/src/index.tsx"]
    },
    "types": ["vitest/globals"]
  }
}
